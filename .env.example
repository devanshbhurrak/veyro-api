# Veyro backend configuration template.
# Copy to .env.local (never commit real secrets) and export before running.
# All values below are placeholders.

# Application
APP_NAME=Veyro
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=info
# Frontend origin used to build links in transactional email.
APP_BASE_URL=http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=veyro
DB_USER=postgres
DB_PASSWORD=change-me
DB_SSL_MODE=disable
DB_POOL_SIZE=10
DB_MIN_CONNS=1
DB_CONNECT_TIMEOUT_SECONDS=5
DB_HEALTH_TIMEOUT_SECONDS=3
DB_MAX_CONN_LIFETIME_SECONDS=3600

# HTTP
HTTP_READ_TIMEOUT=30
HTTP_WRITE_TIMEOUT=30
HTTP_IDLE_TIMEOUT=60
HTTP_SHUTDOWN_TIMEOUT=30
HTTP_ALLOWED_ORIGINS=http://localhost:3000

# Authentication
# REQUIRED in production. Used to encrypt single-use tokens stored in the outbox.
AUTH_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_EMAIL_TOKEN_TTL_HOURS=24
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_INVITATION_TTL_DAYS=7
AUTH_ARGON2_MEMORY_KIB=65536
AUTH_ARGON2_ITERATIONS=3
AUTH_ARGON2_PARALLELISM=2
AUTH_ARGON2_SALT_LENGTH=16
AUTH_ARGON2_KEY_LENGTH=32
AUTH_REFRESH_COOKIE_NAME=veyro_refresh
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_RESEND_WINDOW_SECONDS=3600
AUTH_RESEND_MAX_ATTEMPTS=3
AUTH_PASSWORD_RESET_WINDOW_SECONDS=3600
AUTH_PASSWORD_RESET_MAX_ATTEMPTS=5

# Transactional email
# EMAIL_PROVIDER=log writes .eml files to EMAIL_LOCAL_DIR for development.
# EMAIL_PROVIDER=smtp delivers through SMTP.
EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=no-reply@veyro.local
EMAIL_FROM_NAME=Veyro
EMAIL_LOCAL_DIR=.tmp/emails
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true

# Outbox worker
OUTBOX_WORKER_INTERVAL_SECONDS=5
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_LOCK_SECONDS=60

# Internal platform administration (comma-separated verified emails).
# Leave empty to disable all /api/v1/platform routes.
PLATFORM_ADMIN_EMAILS=
